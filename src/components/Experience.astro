---
import Dual from './Dual.astro';
import JobCard from './JobCard.astro';
import { jobs, education } from '../data/content';
---
<section id="experience">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Experience</span>
      <h2>Where I’ve worked and learned.</h2>
    </header>

    <div class="exp__grid">
      <ol class="jobs">
        {jobs.data.map((_, i) => (
          <Dual as="li" variant="flip-y" i={i} class="reveal" style={`--d:${i}`}>
            <JobCard slot="data" job={jobs.data[i]} />
            <JobCard slot="it" job={jobs.it[i]} />
          </Dual>
        ))}
      </ol>

      <aside class="edu reveal" style="--d:1" aria-labelledby="edu-title">
        <h3 id="edu-title" class="eyebrow">Education &amp; training</h3>
        <ul class="edu__list">
          {education.map((e) => (
            <li>
              <div class="edu__name">{e.title}</div>
              <div class="edu__where">{e.where}</div>
              <div class="edu__when">{e.when}</div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .exp__grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu { position: sticky; top: 6rem; }

  .edu__list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .edu__list li { padding: 1rem 0; border-bottom: 1px solid var(--line); }

  .edu__name { font-size: var(--fs-sm); font-weight: 500; line-height: 1.35; }
  .edu__where { margin-top: 0.2rem; font-size: var(--fs-xs); color: var(--text-soft); }
  .edu__when {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .exp__grid { grid-template-columns: 1fr; }
    .edu { position: static; }
  }
</style>
