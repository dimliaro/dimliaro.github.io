---
import Dual from './Dual.astro';
import Scramble from './Scramble.astro';
import { hero, cvHref, type Mode } from '../data/content';
interface Props { mode: Mode }
const { mode } = Astro.props;
---
<section id="top" class="hero">
  <div class="container hero__grid">
    <div class="hero__main">
      <p class="hero__status reveal">
        <span class="hero__dot" aria-hidden="true"></span>
        <Scramble mode={mode} {...hero.status} />
      </p>

      <h1 class="hero__name reveal" style="--d:1">
        <span class="metal">Dimitris<br />Liaropoulos</span>
      </h1>

      <p class="hero__line reveal" style="--d:2">
        <Scramble mode={mode} {...hero.line} />
      </p>

      <Dual class="hero__lede reveal" style="--d:3" i={2}>
        <p slot="data">{hero.lede.data}</p>
        <p slot="it">{hero.lede.it}</p>
      </Dual>

      <div class="hero__cta reveal" style="--d:4">
        <a class="btn" href="#work">
          See the work
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href={cvHref[mode]} target="_blank" rel="noopener">Download CV</a>
        <button class="hero__switch" type="button" data-mode-toggle>
          <span aria-hidden="true">⇄</span>
          <Scramble mode={mode} {...hero.switchLabel} />
        </button>
      </div>
    </div>

    <aside class="spec panel reveal" style="--d:3" aria-label="Summary">
      <div class="spec__head">
        <span>spec.sheet</span>
        <span class="spec__led" aria-hidden="true"></span>
      </div>
      <dl class="spec__rows">
        {hero.spec.map((row) => (
          <div class="spec__row">
            <dt>{row.key}</dt>
            <dd><Scramble mode={mode} data={row.data} it={row.it} /></dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 370px;
    gap: 4rem;
    align-items: end;
  }

  .hero__main { display: flex; flex-direction: column; gap: 1.5rem; }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse { 50% { box-shadow: 0 0 0 6px transparent; } }

  .hero__name {
    font-size: var(--fs-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .hero__line {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    color: var(--text);
    min-height: 1.2em;
  }

  .hero__lede {
    max-width: 58ch;
    color: var(--text-soft);
    font-size: var(--fs-md);
    line-height: 1.65;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero__switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 0.25rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: 500 var(--fs-xs)/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .hero__switch span:first-child { transition: transform 0.5s var(--ease-mech); }
  .hero__switch:hover span:first-child { transform: rotate(180deg); }

  /* ---------- spec sheet ---------- */
  .spec { padding: 1.1rem 1.25rem 1.25rem; }

  .spec__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.9rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .spec__led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .spec__rows { margin: 0; }

  .spec__row {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .spec__row:last-child { border-bottom: 0; padding-bottom: 0; }

  .spec__row dt { color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .spec__row dd { margin: 0; color: var(--text); }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; gap: 3rem; }
    .spec { max-width: 420px; }
  }
</style>
