---
import Dual from './Dual.astro';
import CaseVisual from './CaseVisual.astro';
import CaseBody from './CaseBody.astro';
import WorkRow from './WorkRow.astro';
import { cases, otherWork } from '../data/content';
---
<section id="work">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Selected work</span>
      <h2>Problems I picked up and saw through.</h2>
    </header>

    <ol class="cases">
      {cases.data.map((_, i) => (
        <li class="case reveal">
          {/* visual and write-up turn separately, so each card reassembles in two moves */}
          <Dual variant="flip-y" i={i * 2} class="case__visual-wrap">
            <CaseVisual slot="data" index={i} label={cases.data[i].visual} />
            <CaseVisual slot="it" index={i} label={cases.it[i].visual} />
          </Dual>
          <Dual variant="fade" i={i * 2 + 1}>
            <CaseBody slot="data" c={cases.data[i]} />
            <CaseBody slot="it" c={cases.it[i]} />
          </Dual>
        </li>
      ))}
    </ol>

    <div class="other">
      <span class="eyebrow reveal">Other work</span>
      <ul class="other__rows">
        {otherWork.data.map((_, i) => (
          <Dual as="li" variant="flip-x" i={i} class="reveal" style={`--d:${i}`}>
            <WorkRow slot="data" row={otherWork.data[i]} />
            <WorkRow slot="it" row={otherWork.it[i]} />
          </Dual>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .case {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .case:nth-child(even) .case__visual-wrap { order: 2; }

  /* ---------- other work ---------- */
  .other { margin-top: 7rem; }

  .other__rows {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .case { grid-template-columns: 1fr; gap: 1.6rem; }
    .case:nth-child(even) .case__visual-wrap { order: 0; }
    .cases { gap: 4rem; }
  }
</style>
