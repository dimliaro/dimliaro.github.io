---
import Dual from './Dual.astro';
import Scramble from './Scramble.astro';
import { about, skills, type Mode } from '../data/content';
interface Props { mode: Mode }
const { mode } = Astro.props;
---
<section id="about">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">About</span>
      <h2><Scramble mode={mode} {...about.heading} /></h2>
    </header>

    <div class="about__grid">
      <Dual class="about__body reveal" i={1}>
        <div slot="data" class="about__paras">{about.paras.data.map((p) => <p>{p}</p>)}</div>
        <div slot="it" class="about__paras">{about.paras.it.map((p) => <p>{p}</p>)}</div>
      </Dual>

      <dl class="facts reveal" style="--d:1">
        {about.facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.data === f.it ? f.data : <Scramble mode={mode} data={f.data} it={f.it} />}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="toolbelt">
      <span class="eyebrow reveal">Toolbelt</span>
      <ul class="toolbelt__rows">
        {skills.data.map((group, i) => (
          <Dual as="li" variant="flip-x" i={i} class="reveal" style={`--d:${i}`}>
            <div slot="data" class="trow">
              <span class="trow__label">{group.label}</span>
              <span class="trow__items">{group.items.join('  ·  ')}</span>
            </div>
            <div slot="it" class="trow">
              <span class="trow__label">{skills.it[i].label}</span>
              <span class="trow__items">{skills.it[i].items.join('  ·  ')}</span>
            </div>
          </Dual>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 200px 1fr 300px;
    gap: 2rem;
  }

  .about__body { grid-column: 2; }

  .about__paras {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 60ch;
    color: var(--text-soft);
    font-size: var(--fs-md);
    line-height: 1.7;
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .fact {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .fact:first-child { padding-top: 0.2rem; }

  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .fact dd { margin: 0; text-align: right; }

  /* ---------- toolbelt ---------- */
  .toolbelt { margin-top: 5rem; }

  .toolbelt__rows {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .trow {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0.4rem 2rem;
    align-items: center;
    height: 100%;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .trow__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .trow__items { color: var(--text); font-size: var(--fs-sm); white-space: pre-wrap; }

  @media (max-width: 960px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__body { grid-column: auto; }
  }

  @media (max-width: 620px) {
    .trow { grid-template-columns: 1fr; }
  }
</style>
