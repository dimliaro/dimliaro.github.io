---
import Dual from './Dual.astro';
import { contact, cvHref, type Mode } from '../data/content';
interface Props { mode: Mode }
const { mode } = Astro.props;
const year = new Date().getFullYear();
---
<section id="contact" class="contact">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Contact</span>
      <h2>Let’s talk.</h2>
    </header>

    <div class="contact__grid">
      <div class="contact__intro">
        <Dual class="contact__lede reveal">
          <p slot="data">{contact.lede.data}</p>
          <p slot="it">{contact.lede.it}</p>
        </Dual>
        <div class="contact__cta reveal" style="--d:1">
          <a class="btn" href={contact.links[0].href}>Send an email</a>
          <a class="btn btn--ghost" href={cvHref[mode]} target="_blank" rel="noopener">Download CV</a>
        </div>
      </div>

      <ul class="links reveal" style="--d:1">
        {contact.links.map((l) => (
          <li>
            <a
              class="link"
              href={l.href}
              {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="link__label">{l.label}</span>
              <span class="link__value">{l.value}</span>
              <span class="link__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <footer class="footer">
    <div class="container footer__inner">
      <span>© {year} Dimitris Liaropoulos</span>
      <span>Athens, Greece</span>
    </div>
  </footer>
</section>

<style>
  .contact { padding-bottom: 0; }

  .contact__grid {
    display: grid;
    grid-template-columns: 200px 1fr 1fr;
    gap: 2rem 3rem;
    align-items: start;
  }

  .contact__intro { grid-column: 2; display: flex; flex-direction: column; gap: 1.8rem; }

  .contact__lede { color: var(--text-soft); font-size: var(--fs-md); line-height: 1.7; max-width: 48ch; }

  .contact__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .links { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }

  .link {
    display: grid;
    grid-template-columns: 90px 1fr 20px;
    gap: 1rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.4s var(--ease-out);
  }
  .link:hover { padding-left: 0.5rem; }

  .link__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .link__value { font-size: var(--fs-sm); overflow-wrap: anywhere; }
  .link__arrow { color: var(--text-muted); transition: color 0.3s ease, transform 0.3s var(--ease-out); }
  .link:hover .link__arrow { color: var(--accent); transform: translate(2px, -2px); }

  .footer { margin-top: 7rem; border-top: 1px solid var(--line); padding: 1.6rem 0; }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .contact__grid { grid-template-columns: 1fr; }
    .contact__intro { grid-column: auto; }
  }
</style>
