---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dimitris Liaropoulos — Data Analyst · Python, SQL & AI/LLM tools',
  description = 'Dimitris Liaropoulos — Computer Science graduate (AUEB) from Athens building a career in data. Python, SQL, EDA, RAG pipelines and football analytics. Open to junior data roles.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Dimitris Liaropoulos" />
    <meta name="theme-color" content="#FFF8EE" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Flag JS early so .reveal elements are only hidden when the observer will un-hide them -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <main>
      <slot />
    </main>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
